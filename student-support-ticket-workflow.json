    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  // Use item.json.body if you're on a Webhook node\n  const data = item.json.body ?? item.json;\n\n  const getField = (...names) => {\n    const key = Object.keys(data).find(k =>\n      names.includes(k.toLowerCase().replace(/[^a-z0-9]/g, \"\"))\n    );\n    return key ? String(data[key] ?? \"\").trim() : \"\";\n  };\n\n  const studentName = getField(\"studentname\", \"name\");\n  const studentEmail = getField(\"studentemail\", \"email\");\n  const category = getField(\"complaintcategory\", \"category\");\n  const description = getField(\"complaintdescription\", \"description\", \"complaint\");\n\n  const text = `${category} ${description}`.toLowerCase();\n\n  // Department (first match wins, so keep the most specific rules first)\n  let department = \"Campus Administration\";\n  if (/\\bwi-?fi\\b|\\binternet\\b|\\bnetwork\\b/.test(text)) {\n    department = \"IT Support\";\n  } else if (/\\bclassroom\\b|\\bprojector\\b|\\bdesk\\b|\\blecture\\b/.test(text)) {\n    department = \"Academic Facilities\";\n  } else if (/\\bhostel\\b|\\bdorm\\b|\\broom\\b|water supply/.test(text)) {\n    department = \"Hostel Management\";\n  } else if (/maintenance|repair|plumbing|electric|washroom|toilet/.test(text)) {\n    department = \"Maintenance Team\";\n  }\n\n  // Priority\n  let priority = \"Medium\";\n  if (/\\bfire\\b|smoke|emergency|exposed wire|electric shock/.test(text)) {\n    priority = \"Critical\";\n  } else if (/urgent|not working|outage|leak|unsafe/.test(text)) {\n    priority = \"High\";\n  } else if (/suggestion|feedback|request/.test(text)) {\n    priority = \"Low\";\n  }\n\n  const valid = Boolean(studentEmail && description);\n\n  return {\n    json: {\n      ticketId: `SC-${Date.now()}-${String(index + 1).padStart(3, \"0\")}`,\n      studentName,\n      studentEmail,\n      category,\n      description,\n      department,\n      priority,\n      status: valid ? \"Open\" : \"Invalid\",\n      submittedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
